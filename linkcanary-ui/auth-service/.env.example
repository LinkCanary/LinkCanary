# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# Public URL where this service is reachable (behind Caddy)
BETTER_AUTH_URL=http://localhost:3000/auth

# PostgreSQL — same database as the FastAPI app
DATABASE_URL=postgresql://linkcanary:linkcanary@postgres:5432/linkcanary

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP for verification emails (Resend, SendGrid, or any SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@linkcanary.io

API_URL=http://api:3000
AUTH_WEBHOOK_SECRET=
